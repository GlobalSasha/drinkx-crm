# Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# «Войти как тестовый пользователь» button on /sign-in — local dev only.
# Leave both empty in production: the button (and its credentials) is then
# never rendered and never reaches the client bundle.
NEXT_PUBLIC_TEST_LOGIN_EMAIL=
NEXT_PUBLIC_TEST_LOGIN_PASSWORD=

# Локальный стенд без Supabase (зеркало dev-режима бэкенда, ADR-014).
# `1` — middleware не ходит в Supabase Auth, на /sign-in появляется кнопка
# «Войти локально (dev)», запросы к API уходят без токена, и backend в
# stub-режиме принимает их под `dev@drinkx.tech`. Работает только при
# NODE_ENV != production: в production-сборке флаг игнорируется.
NEXT_PUBLIC_DEV_AUTH_BYPASS=
